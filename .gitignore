.agents/settings.local.json
.claude/settings.local.json
.agents/scheduled_tasks.lock
.claude/scheduled_tasks.lock

# Python
.venv/
__pycache__/
*.py[cod]

# OS and editors
.DS_Store
*~
*.swp
.vscode/*
!.vscode/extensions.json

# CAD: tools/build-cad.sh moves outputs into cad/out/; STL and previews there are
# committed, STEP is not. Anything left next to the scripts is a build leftover.
cad/*.stl
cad/*.step
cad/*_preview.png
cad/.run_*.json
cad/.*.log
cad/out/*.step

# Host build trees (tools/host-test.sh)
/build/
