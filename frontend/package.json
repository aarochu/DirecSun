{
  "name": "direcsun-frontend",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "demo": "node scripts/demo.mjs",
    "demo:serve": "node scripts/demo.mjs --no-build",
    "demo:check": "node scripts/demo.mjs --check",
    "test": "node --test \"scripts/*.test.mjs\" && vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "animejs": "4.5.0",
    "three": "0.155.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/three": "0.155.1",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
