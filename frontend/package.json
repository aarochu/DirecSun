{
  "name": "direcsun-frontend",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "build:demo": "npm run build && npm run build:deploy --prefix draft",
    "demo:check": "node scripts/serve-demo.mjs --check",
    "demo:serve": "node scripts/serve-demo.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "animejs": "4.5.0",
    "three": "0.155.0"
  },
  "devDependencies": {
    "@types/three": "0.155.1",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
