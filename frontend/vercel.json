{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci && npm ci --prefix ground-station",
  "buildCommand": "npm run build && npm run build:deploy --prefix ground-station",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/draft/ground-station",
      "destination": "/ground-station/",
      "permanent": false
    },
    {
      "source": "/draft/:path*",
      "destination": "/ground-station/overview",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/ground-station",
      "destination": "/ground-station/index.html"
    },
    {
      "source": "/ground-station/([^.]*)",
      "destination": "/ground-station/index.html"
    }
  ]
}
