{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/skills/spec-driven-dev/hooks/spec-gate.sh pre-merge",
            "timeout": 15,
            "statusMessage": "spec-gate: checking merge gate"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/skills/spec-driven-dev/hooks/spec-gate.sh stop",
            "timeout": 15,
            "statusMessage": "spec-gate: checking paper trail"
          }
        ]
      }
    ]
  }
}
